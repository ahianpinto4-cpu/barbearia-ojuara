# =============================================================================
# Barbearia Ojuara — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA coloque valores reais neste arquivo. Na Vercel: Settings → Environment Variables.
# =============================================================================

# Ambiente: development | test | production
APP_ENV=development

# URL pública do site (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=

# Número que recebe as conversas iniciadas pelo site (wa.me). Deve ser o número
# conectado à WhatsApp Cloud API. Vazio = número oficial (5579999345023).
# Durante os testes com o número de teste da Meta, coloque-o aqui.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Banco de dados (Supabase → Project Settings → Database → Connection string)
# Use a string do "Transaction pooler" (porta 6543) em produção/serverless.
DATABASE_URL=

# Opcionais (não usados pelo backend atual; mantidos para integrações futuras)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel administrativo
# Segredo para assinar a sessão (mínimo 32 caracteres aleatórios).
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# --- WhatsApp Business Platform (Cloud API oficial da Meta)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# "true" = não envia nada para a Meta (só registra). Útil em desenvolvimento.
WHATSAPP_DRY_RUN=false

# Destinatários (também editáveis no painel → Configurações)
# Teste: número COMPLETO do responsável, com DDI e DDD (13 dígitos, ex.: 5579912345678).
# O número informado (79 9664 8360) tem 10 dígitos e parece incompleto — confirme antes de preencher.
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_PRODUCTION_RECIPIENT=5579999345023

# --- Claude API (assistente virtual)
CLAUDE_API_KEY=
# Modelo (padrão: claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# --- Lembretes (Vercel Cron envia "Authorization: Bearer CRON_SECRET")
CRON_SECRET=
